# ==============================================================================
# DIGITAL BEGGAR — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local to configure your local or production environment.

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY CONFIGURATION (Phase 2 Razorpay Sandbox Integration)
# ------------------------------------------------------------------------------
# Supported modes: 'demo' | 'razorpay_test' | 'razorpay_live'
# Default: demo (safe simulation without live credentials)
PAYMENT_MODE=demo

# Razorpay API Credentials (TEST MODE: rzp_test_... / LIVE: rzp_live_...)
# Only Key ID may be passed to the browser checkout; KEY_SECRET and WEBHOOK_SECRET
# are strictly confidential and must NEVER be exposed via NEXT_PUBLIC_* variables.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Webhook Secret (Configured in Razorpay Dashboard > Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# Optional public key mirror for client-side Razorpay standard checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Phase 4 Database & Auth)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anonymous Client Key (Public browser-safe key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase SERVICE ROLE KEY (Server-Side Only)
# CRITICAL: NEVER expose this key to client-side code or public repos.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# ADMIN AUTHORIZATION
# ------------------------------------------------------------------------------
# Server-side authorized admin email allowlist. Only users authenticated with this
# email address can access /admin and execute privileged /api/admin/* endpoints.
ADMIN_EMAIL=admin@digitalbeggar.com

# ------------------------------------------------------------------------------
# DEMO & SIMULATION CONTROLS
# ------------------------------------------------------------------------------
# Set to 'true' to run with in-memory simulation repository even if Supabase keys exist.
# Set to 'false' in production. In production, demo reset/pause/reaction controls are locked.
DEMO_MODE=true

# ------------------------------------------------------------------------------
# STREAM DEFAULTS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_STREAM_ID=stream_default_main
